# להעתיק ל-automations/.env (לא עולה לגיטהאב) ולמלא.

# Supabase ← Project Settings ← API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# service_role key – סודי! רק כאן, לעולם לא באפליקציה ולא בגיטהאב
SUPABASE_SERVICE_KEY=

# מזהה המשתמש שלך: באפליקציה ← גיבוי והגדרות ← ענן ואוטומציות (אחרי התחברות)
USER_ID=

# מודל ← לוח שנה ← ייצוא לוח שנה ← "כל האירועים" + "60 הימים הקרובים" ← קבלת כתובת
MOODLE_ICS_URL=

# console.anthropic.com ← API Keys (לניתוח מיילים; בלי זה רק אוטומציית המייל לא תעבוד)
ANTHROPIC_API_KEY=
